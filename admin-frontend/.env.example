# Admin console configuration. Copy to .env.local.
# Production: see DEPLOY.md. NEXT_PUBLIC_*
# values are baked in at build time — rebuild after changing them.

# api = real backend; mock = simulated locally
NEXT_PUBLIC_DATA_SOURCE=api
# Backend base URL (production: https://api.yourdomain.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Public website (links to live pages from the console; production: https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
