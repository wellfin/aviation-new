# ─────────────────────────────────────────────────────────────
# Global Aviation Services Directory — frontend configuration
# Copy to .env.local. Every integration defaults to "mock" so the
# site runs with zero keys. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Production: see DEPLOY.md. NEXT_PUBLIC_*
# values are baked in at build time — rebuild after changing them.

# Public site URL (used for metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Platform backend (/api/v1) ───────────────────────────────
# mock = in-repo demo data; api = call the backend at API_BASE_URL
DATA_SOURCE=mock
API_BASE_URL=http://localhost:4000
# Browser-side forms & auth: mock = simulated locally; api = call the backend
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Aviation weather (METAR / TAF) ───────────────────────────
# aviationweather (https://aviationweather.gov/data/api/ — free, no key) | checkwx (key) | mock
WEATHER_PROVIDER=aviationweather
CHECKWX_API_KEY=

# ── NOTAMs ───────────────────────────────────────────────────
# faa-search (https://notams.aim.faa.gov/notamSearch — public, no key; the FAA blocks some
# regions, so it may only work from a US-hosted server) | faa (official FAA NOTAM API,
# free keys at https://api.faa.gov — also used as automatic fallback for faa-search) | mock
NOTAM_PROVIDER=faa-search
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=

# ── Airport reference data & aviation map (OpenAIP) ──────────
# openaip (runways, frequencies, elevation from https://www.openaip.net) | airportdb | mock
# Get a free key: openaip.net → sign in → API Clients → create client.
AIRPORT_DATA_PROVIDER=openaip
OPENAIP_API_KEY=
AIRPORTDB_API_TOKEN=
# Browser key for the OpenAIP aviation map overlay (can be the same key; restrict it to your domain).
# Street maps (OpenStreetMap) and satellite imagery (Esri) need no key.
NEXT_PUBLIC_OPENAIP_API_KEY=

# Timeout for every third-party call (ms)
INTEGRATION_TIMEOUT_MS=8000

# Admin console (separate app)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3200

# Must equal the API's INTERNAL_API_KEY (server-only; never NEXT_PUBLIC_)
INTERNAL_API_KEY=

# Optional: extra hosts allowed to serve uploaded images (comma separated), e.g. a previous
# server IP still stored in older records. The API host above is always allowed.
IMAGE_REMOTE_HOSTS=
