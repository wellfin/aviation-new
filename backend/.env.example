# ─────────────────────────────────────────────────────────────
# Global Aviation Services Directory — API configuration
# Copy to .env and fill in. Never commit real secrets.
# Production: see DEPLOY.md (section "Create the .env files").
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (for client IPs / rate limits)
TRUST_PROXY=0

# MongoDB — must be a replica set (transactions). `npm run db:start` runs one locally on 27018.
MONGODB_URI=mongodb://127.0.0.1:27018/global_aviation?replicaSet=rs0

# Frontend origins allowed to call the API with cookies (comma separated)
CORS_ORIGINS=http://localhost:3100,http://localhost:3200
FRONTEND_URL=http://localhost:3100
PUBLIC_API_URL=http://localhost:4000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_SHORT_TTL_HOURS=24
# COOKIE_DOMAIN=.yourdomain.com
# COOKIE_SECURE=true   (defaults to true in production)

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# Email — "log" writes messages to .mail-outbox/ (dev); "smtp" sends for real (required in production)
MAIL_TRANSPORT=log
MAIL_FROM="Global Aviation <no-reply@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# OAuth (optional). Callback URLs: {PUBLIC_API_URL}/api/v1/auth/oauth/{google|linkedin}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Razorpay (subscriptions). Webhook URL: {PUBLIC_API_URL}/api/v1/billing/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Uploads (local disk; served at /api/v1/files/...)
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOCUMENT_MB=15

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# Shared secret sent by the website server (SSR) to bypass the per-IP global limit (48+ random chars)
INTERNAL_API_KEY=
SESSION_RATE_LIMIT_MAX=300
OTP_RATE_LIMIT_MAX=30
